[Desktop Entry]
Type=Application
Name=Update History
Name[de]=Update-Verlauf
GenericName=Package Update History
GenericName[de]=Paket-Update-Verlauf
Comment=Show recent Pacman, AUR and Flatpak package updates
Comment[de]=Kürzliche Paketänderungen von Pacman, AUR und Flatpak anzeigen
